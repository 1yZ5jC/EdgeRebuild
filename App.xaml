<Application
    x:Class="EdgeRebuild.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources ControlsResourcesVersion="Version1" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局圆角重置 -->
            <Style TargetType="muxc:NavigationView">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- ContentDialog 样式：自身直角 + 按钮直角 -->
            <Style TargetType="ContentDialog">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="PrimaryButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="SecondaryButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CloseButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <Thickness x:Key="ButtonPadding">8,4,8,4</Thickness>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>