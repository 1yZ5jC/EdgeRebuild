<Application
    x:Class="EdgeRebuild.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources ControlsResourcesVersion="Version1" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局圆角重置 -->
            <Style TargetType="NavigationView">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ListView">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="ScrollViewer">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- ContentDialog 样式：自身直角 + 按钮直角 -->
            <Style TargetType="ContentDialog">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="PrimaryButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="SecondaryButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="CloseButtonStyle">
                    <Setter.Value>
                        <Style TargetType="Button">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
            <Thickness x:Key="ButtonPadding">8,4,8,4</Thickness>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
            <!-- 旧版 Edge 标签栏图标字体（仅含图标字形，随应用打包） -->
            <FontFamily x:Key="BrowserMdlFontFamily">ms-appx:///Assets/Fonts/BrowserMDL.ttf#Browser MDL2 Assets</FontFamily>

            <!-- Metro IE 窗口按钮样式（放 Application.Resources：UserControl 的
                 StaticResource 解析时看不到父 Page 资源，必须全局可见） -->
            <Style x:Key="MetroNavButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="48"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Content" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF555555"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                    <ContentPresenter x:Name="Content" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MetroAppBarButtonStyle" TargetType="Button" BasedOn="{StaticResource MetroNavButtonStyle}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Width" Value="56"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>