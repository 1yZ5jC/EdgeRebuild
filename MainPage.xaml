<Page
    x:Class="EdgeRebuild.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EdgeRebuild.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Windows.UI.Xaml.Media">

    <Page.Resources>
        <AcrylicBrush x:Key="ToolbarAcrylicBrush"
                      BackgroundSource="HostBackdrop"
                      TintColor="#F0F0F0"
                      TintOpacity="0.8"
                      FallbackColor="#F0F0F0"/>

        <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="AddressBarFocusBorderBrush" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#60FFFFFF"/>
        <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#000000"/>
        <SolidColorBrush x:Key="MutedForegroundBrush" Color="#666666"/>


        <!-- 在 MainPage.xaml 的 Page.Resources 中添加 -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RevealHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RevealPressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverBorder" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        

        <!-- Fluent Reveal 笔刷 -->
        <SolidColorBrush x:Key="RevealHoverBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="RevealPressedBrush" Color="#80FFFFFF"/>

        <!-- Fluent Reveal 按钮样式（无彩色边框） -->
        <Style x:Key="RevealButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RevealBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RevealHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RevealBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource RevealPressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RevealBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#40FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AddressBarFocusBorderBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#80FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="BorderElement" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressBarStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource AddressBarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AddressBarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8,4,0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="SelectionHighlightColor" Value="{ThemeResource SystemAccentColor}"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 标题栏拖拽区（始终可见，水平/垂直模式共用；亚克力背景 + 窗口拖拽） -->
        <Border x:Name="TitleBarHost" Grid.Row="0" Grid.Column="1"
                Background="{StaticResource ToolbarAcrylicBrush}">
            <Rectangle x:Name="TitleBarDragArea" Fill="Transparent"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>

        <!-- 垂直标签栏侧边栏（默认隐藏，设置中切换） -->
        <Border x:Name="VerticalTabSidebar" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0"
                Width="220" Visibility="Collapsed"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource SeparatorBrush}">
            <Grid Background="{StaticResource ToolbarAcrylicBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 标题栏拖拽区（整行可拖拽窗口，按钮覆盖在上方） -->
                <Grid Grid.Row="0">
                    <Rectangle x:Name="VerticalTitleBarDragArea" Fill="Transparent" Height="32"
                               HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                    <Grid Margin="8,0,4,0" Height="32" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VerticalTabTitle" Grid.Column="0" Text="垂直标签" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   IsHitTestVisible="False"/>
                        <StackPanel x:Name="VerticalButtonsHost" Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                            <Button x:Name="VerticalNewTabBtn" Content="&#xE710;"
                                    Style="{StaticResource RevealButtonStyle}" Width="26" Height="26"
                                    Click="VerticalNewTabBtn_Click" ToolTipService.ToolTip="新建标签页"/>
                            <Button x:Name="VerticalTabToggleBtn" Content="&#xE711;"
                                    Style="{StaticResource RevealButtonStyle}" Width="26" Height="26"
                                    Click="VerticalTabToggleBtn_Click" ToolTipService.ToolTip="切换回水平标签栏"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" x:Name="VerticalTabEmptyHint" Visibility="Collapsed">
                    <TextBlock x:Name="VerticalTabEmptyText" Text="暂无标签页" FontSize="12" Opacity="0.4"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="VerticalTabPanel" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 标签栏（覆盖在 TitleBarHost 上方；垂直模式时隐藏） -->
        <Border x:Name="TabBarBorder" Grid.Row="0" Grid.RowSpan="1" Grid.Column="1"
                Padding="0" SizeChanged="TabBarBorder_SizeChanged"
                Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- InPrivate 徽标（仅隐身窗口显示） -->
                <Border x:Name="InPrivateBadge" Grid.Column="0" Visibility="Collapsed"
                        Background="#2D2D30" Height="22" Padding="8,0"
                        VerticalAlignment="Center" Margin="6,0,4,0"
                        ToolTipService.ToolTip="InPrivate 浏览：不保存历史记录、Cookie 与站点数据">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEC25;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="InPrivate" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="ScrollLeftBtn" Grid.Column="0" Content="&#xE76B;"
                        Style="{StaticResource RevealButtonStyle}" Width="24" Height="24"
                        Click="ScrollLeftBtn_Click" Foreground="{StaticResource MutedForegroundBrush}"
                        VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>

                <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch"
                              HorizontalScrollMode="Enabled"
                              Background="Transparent"
                              IsTabStop="False"
                              UseSystemFocusVisuals="False"
                              ViewChanged="TabScrollViewer_ViewChanged">
                    <StackPanel x:Name="TabBarPanel" Orientation="Horizontal"
                                VerticalAlignment="Stretch" Background="Transparent" />
                </ScrollViewer>

                <StackPanel x:Name="RightSidePanel" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Background="Transparent" Margin="0,0,50,0">
                    <Button x:Name="ScrollRightBtn" Content="&#xE76C;"
                            Style="{StaticResource RevealButtonStyle}" Width="24" Height="24"
                            Click="ScrollRightBtn_Click" Foreground="{StaticResource MutedForegroundBrush}"
                            Visibility="Collapsed" Margin="0,0,0,0"/>
                    <Button x:Name="NewTabButton" Content="&#xE710;"
                            Style="{StaticResource RevealButtonStyle}" Width="32" Height="32"
                            Click="NewTabBtn_Click" Foreground="{StaticResource MutedForegroundBrush}"
                            Margin="0,0,0,0"/>
                </StackPanel>

                <Rectangle x:Name="OldTitleBarDragArea" Fill="Transparent"
                           Grid.Column="3" VerticalAlignment="Stretch" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <controls:ToolbarControl x:Name="toolbarControl"
                                 Grid.Row="1" Grid.Column="1"
                                 UrlSubmitted="ToolbarControl_UrlSubmitted"
                                 BackRequested="ToolbarControl_BackRequested"
                                 ForwardRequested="ToolbarControl_ForwardRequested"
                                 RefreshRequested="ToolbarControl_RefreshRequested"
                                 AddFavoriteClicked="ToolbarControl_AddFavoriteClicked"
                                 CaptureClicked="ToolbarControl_CaptureClicked"
                                 HubClicked="ToolbarControl_HubClicked"
                                 MenuClicked="ToolbarControl_MenuClicked"
                                 EngineSwitched="ToolbarControl_EngineSwitched"/>

        <!-- 活动标签接缝：盖住活动标签正下方 1px 的工具栏顶边线，保持无缝 -->
        <Border x:Name="ActiveTabSeam" Grid.Row="1" Grid.Column="1"
                Height="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="White" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 收藏夹栏(参考规范 §6.1:工具栏下方常驻行) -->
        <Border x:Name="FavoritesBar" Grid.Row="2" Grid.Column="1" Visibility="Collapsed"
                Background="{StaticResource ToolbarAcrylicBrush}" Height="44">
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalAlignment="Center">
                    <StackPanel x:Name="FavoritesBarPanel" Orientation="Horizontal" Margin="12,0"/>
                </ScrollViewer>
                <TextBlock x:Name="FavoritesBarEmpty" Text="将网页加入收藏后即可在此栏快速访问"
                           FontSize="12" VerticalAlignment="Center" Margin="14,0"
                           Foreground="{StaticResource MutedForegroundBrush}"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 网页区域 -->
        <Grid Grid.Row="3" Grid.Column="1">
            <SplitView x:Name="HubSplitView" DisplayMode="Overlay"
                       OpenPaneLength="520" PanePlacement="Right"
                       PaneBackground="{StaticResource ToolbarAcrylicBrush}">
                <SplitView.Pane>
                    <controls:HubPane x:Name="hubPane"
                                      NavigateRequested="HubPane_NavigateRequested"
                                      CloseRequested="HubPane_CloseRequested"
                                      Width="520"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>
                </SplitView.Pane>
                <Grid x:Name="ContentContainer" Background="White"/>
            </SplitView>

            <SplitView x:Name="SettingsSplitView" DisplayMode="Overlay"
                       OpenPaneLength="520" PanePlacement="Right"
                       PaneBackground="{StaticResource ToolbarAcrylicBrush}"
                       Canvas.ZIndex="60">
                <SplitView.Content>
                    <Grid Background="Transparent" IsHitTestVisible="False"/>
                </SplitView.Content>
                <SplitView.Pane>
                    <controls:SettingsPane x:Name="SettingsPaneControl" CloseRequested="SettingsPane_CloseRequested"/>
                </SplitView.Pane>
            </SplitView>

            <Border x:Name="FindBar" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,16,0" Padding="8,6"
                    Background="{StaticResource ToolbarAcrylicBrush}"
                    BorderBrush="{StaticResource MutedForegroundBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="80">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="FindBox" Width="220" PlaceholderText="在页面中查找"
                             TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
                    <TextBlock x:Name="FindResultText" VerticalAlignment="Center"
                               MinWidth="44" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedForegroundBrush}"/>
                    <Button x:Name="FindPrevBtn" Content="&#xE70E;" Width="30" Height="30"
                            Style="{StaticResource RevealButtonStyle}"
                            ToolTipService.ToolTip="上一个（Shift+Enter）"
                            Click="FindPrevBtn_Click"/>
                    <Button x:Name="FindNextBtn" Content="&#xE70D;" Width="30" Height="30"
                            Style="{StaticResource RevealButtonStyle}"
                            ToolTipService.ToolTip="下一个（Enter）"
                            Click="FindNextBtn_Click"/>
                    <Button x:Name="FindCloseBtn" Content="&#xE711;" Width="30" Height="30"
                            Style="{StaticResource RevealButtonStyle}"
                            ToolTipService.ToolTip="关闭（Esc）"
                            Click="FindCloseBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 网页捕获覆盖层：截图 + 画笔批注（保留在可视树中以便 RenderTargetBitmap 合成） -->
        <!-- 网页捕获覆盖层：只覆盖网页区域（Row 2），地址栏/标签栏保持可见，如同旧版 Edge 批注模式 -->
        <Grid x:Name="CaptureOverlay" Visibility="Collapsed" Grid.Row="3" Grid.Column="1" Canvas.ZIndex="90"
              Background="#A0000000" Tapped="CaptureOverlay_Tapped">
                <Border x:Name="CaptureBorder" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="Gray" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="CaptureTitle" Text="网页捕获 - 在图上批注，然后保存或复制" FontSize="13"/>
                        <InkToolbar x:Name="CaptureInkToolbar" HorizontalAlignment="Left">
                            <InkToolbarHighlighterButton/>
                        </InkToolbar>
                        <Grid x:Name="CaptureImageGrid" Background="White"
                              PointerPressed="CaptureImageGrid_PointerPressed"
                              PointerMoved="CaptureImageGrid_PointerMoved"
                              PointerReleased="CaptureImageGrid_PointerReleased">
                            <Image x:Name="CaptureImage" Stretch="Uniform"/>
                            <InkCanvas x:Name="CaptureInk"/>
                            <Canvas x:Name="CaptureCropLayer" IsHitTestVisible="False">
                                <Rectangle x:Name="CaptureCropRect" Visibility="Collapsed"
                                           Stroke="Red" StrokeThickness="1.5" StrokeDashArray="4,3"
                                           Fill="#22000000"/>
                                <TextBlock x:Name="CaptureCropSize" Visibility="Collapsed"
                                           Foreground="White" FontSize="12" IsHitTestVisible="False"
                                           Text="0×0"/>
                            </Canvas>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="CaptureSaveBtn" Content="保存" Click="CaptureSaveBtn_Click"/>
                            <Button x:Name="CaptureCropBtn" Content="裁剪" Click="CaptureCropBtn_Click"/>
                            <Button x:Name="CaptureCopyBtn" Content="复制" Click="CaptureCopyBtn_Click"/>
                            <Button x:Name="CaptureCloseBtn" Content="取消" Click="CaptureCloseBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
        </Grid>

        <Canvas x:Name="DragCanvas" Grid.RowSpan="4" Background="Transparent"
                IsHitTestVisible="False" Canvas.ZIndex="1000"/>

        <!-- 大声朗读控制浮层：网页/EPUB 朗读时的播放控制（直角 + 主题化，颜色由 ApplyTheme 提供） -->
        <Border x:Name="ReadAloudBar" Visibility="Collapsed" Grid.Row="3"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Padding="14,6" BorderThickness="1"
                Canvas.ZIndex="95">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon x:Name="ReadAloudIcon" Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets"
                          FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="ReadAloudLabel" Text="正在朗读" FontSize="13"
                           VerticalAlignment="Center" MaxWidth="280"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ReadAloudPauseBtn" Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                        FontSize="14" Padding="10,4" MinWidth="40"
                        Click="ReadAloudPauseBtn_Click"
                        ToolTipService.ToolTip="暂停/继续"/>
                <Button x:Name="ReadAloudStopBtn" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                        FontSize="14" Padding="10,4" MinWidth="40"
                        Click="ReadAloudStopBtn_Click"
                        ToolTipService.ToolTip="停止朗读"/>
                <Button x:Name="ReadAloudCloseBtn" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        FontSize="12" Padding="8,4" MinWidth="32"
                        Click="ReadAloudCloseBtn_Click"
                        ToolTipService.ToolTip="隐藏面板（朗读继续）"/>
            </StackPanel>
        </Border>

        <!-- 大声朗读播放器（隐藏）：Windows.Media.SpeechSynthesis 流经此播放 -->
        <MediaElement x:Name="TtsPlayer" AutoPlay="True" Visibility="Collapsed"/>
    </Grid>
</Page>