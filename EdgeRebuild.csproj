<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64;arm64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!-- NativeAOT 版本策略：不要显式固定 Microsoft.DotNet.ILCompiler，也不要设置
         RuntimeFrameworkVersion。运行时包与 ILCompiler 由同一套 SDK bundled 版本
         （Microsoft.NETCoreSdk.BundledVersions.props）成套解析，天然保持一致。
         手动固定其中一方会随 SDK/补丁升级漂移，发布时报
         “Overriding System.Private.CoreLib.dll with a newer version is not supported”。
         升级 .NET 9 补丁时只升级 SDK 即可。 -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PackageCertificateKeyFile>EdgeRebuild_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxPackageSigningTimestampServerUrl>http://timestamp.digicert.com</AppxPackageSigningTimestampServerUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|arm64'">
    <Optimize>False</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Controls\TabBarControl.xaml.cs" />
    <Compile Remove="FavoritesPage.xaml.cs" />
    <Compile Remove="Themes\ModernIE.xaml.cs" />
    <Compile Remove="Themes\Spartan.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="Controls\TabBarControl.xaml" />
    <Page Remove="FavoritesPage.xaml" />
    <Page Remove="Themes\ModernIE.xaml" />
    <Page Remove="Themes\Spartan.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Themes\ModernIE.xaml" />
    <Content Include="Themes\Spartan.xaml" />
    <Content Include="Assets\MarkScript.js" />
    <Content Include="Assets\Readability.js" />
    <Content Include="Assets\PdfViewer\**" />
    <Content Include="Assets\EpubReader\jszip.min.js" />
    <Content Include="Assets\EpubReader\**" />
    <Content Include="Assets\Ntp\**" />
    <Content Include="Assets\NtpMetro\**" />
    <Content Include="Assets\ErrorPages\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="docs\**" />
    <EmbeddedResource Remove="docs\**" />
    <None Remove="docs\**" />
    <Page Remove="docs\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- 测试工程目录：不编入主应用（xunit 引用仅存在于测试工程） -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Remove="docs\**" />
  </ItemGroup>
  <!--
    GetSDKReferenceFiles 默认把 UWP 扩展 SDK（VCLibs / UniversalCRT 等）的扫描缓存写到
    %TEMP%\MSBuildTemp<guid>。该目录一旦被系统或清理工具删除，任务里的
    Directory.EnumerateFiles 就会抛 DirectoryNotFoundException，报
    MSB3795: Could not find a part of the path '...\MSBuildTemp...'。
    把缓存固定到 obj 下，并在 ResolveSDKReferences 前确保目录存在，避免依赖 MSBuild 临时目录。
  -->
  <Target Name="_EnsureSDKReferenceFilesCacheFolder" BeforeTargets="ResolveSDKReferences">
    <PropertyGroup>
      <GetSDKReferenceFilesCacheFolder Condition="'$(GetSDKReferenceFilesCacheFolder)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'SDKReferenceCache'))</GetSDKReferenceFilesCacheFolder>
    </PropertyGroup>
    <MakeDir Directories="$(GetSDKReferenceFilesCacheFolder)" />
  </Target>
</Project>