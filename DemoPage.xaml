<Page
    x:Class="EdgeRebuild.DemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">

            <TextBlock x:Name="TitleText"
                       Text="多窗口 Demo"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="InfoText"
                       Text=""
                       FontSize="14"
                       Opacity="0.65"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="ActiveText"
                       Text=""
                       FontSize="14"
                       HorizontalAlignment="Center"/>

            <Button x:Name="NewWindowBtn"
                    Content="打开新窗口"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Click="OnNewWindow"/>

            <TextBlock x:Name="LogText"
                       Text="日志：LocalState\crash.log"
                       FontSize="12"
                       Opacity="0.45"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

        </StackPanel>
    </Grid>
</Page>
