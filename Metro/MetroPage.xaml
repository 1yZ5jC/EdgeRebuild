<Page
    x:Class="EdgeRebuild.Metro.MetroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:metro="using:EdgeRebuild.Metro"
    Background="#FF2D2D30"
    RequestedTheme="Dark"
    KeyDown="Page_KeyDown" KeyUp="Page_KeyUp">

    <!-- 布局（Metro IE 真实形态）：Row0 标题栏 / Row1 内容区 / Row2 底部标签条 / Row3 底部地址栏。
         其余功能（新建标签/标签视图/刷新/全屏/设置）收进底部命令栏（Windows 8.1 AppBar 形态：
         平时隐藏，右键或命令唤出，图标+文字平铺）。
         网页空白处右键 = 唤出命令栏；链接/图片/选区右键 = 就近小菜单（MetroPage 代码隐藏）。 -->
    <Grid RightTapped="Root_RightTapped" PointerPressed="Root_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：显示当前页标题，整条可拖动（ExtendsContentIntoTitleBar 下默认全标题栏区域可拖）；全屏时隐藏 -->
        <Grid x:Name="TopBar" Grid.Row="0" Height="32" Background="#FF2D2D30">
            <TextBlock x:Name="TopBarTitle" Text="Metro IE" FontFamily="Segoe UI" FontSize="12"
                       Foreground="#FF8E8E8E" VerticalAlignment="Center" Margin="12,0,140,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- 内容区（必须用 Grid：StackPanel 给子元素无限高度，WebView 会塌成 0 高不可见） -->
        <Grid Grid.Row="1">
            <Grid x:Name="ContentPanel" Background="#FF1E1E1E"/>
        </Grid>

        <!-- 底部标签条（横向滚动，当前标签蓝底） -->
        <metro:MetroTabStripControl x:Name="TabStrip" Grid.Row="2"
            TabSelected="TabStrip_TabSelected"
            TabCloseRequested="TabStrip_TabCloseRequested"
            NewTabRequested="TabStrip_NewTabRequested"/>

        <!-- 底部地址栏 -->
        <metro:MetroAddressBarControl x:Name="AddressBar" Grid.Row="3"
            BackRequested="AddressBar_BackRequested"
            ForwardRequested="AddressBar_ForwardRequested"
            RefreshRequested="AddressBar_RefreshRequested"
            HomeRequested="AddressBar_HomeRequested"
            FullscreenRequested="AddressBar_FullscreenRequested"
            UrlSubmitted="AddressBar_UrlSubmitted"/>

        <!-- 底部命令栏覆盖层（滑入/滑出动画见代码隐藏） -->
        <metro:MetroAppBarControl x:Name="CommandBar" Grid.RowSpan="4"
            VerticalAlignment="Bottom" Visibility="Collapsed"
            NewTabClicked="CommandBar_NewTabClicked"
            TabsClicked="CommandBar_TabsClicked"
            RefreshClicked="CommandBar_RefreshClicked"
            FullscreenClicked="CommandBar_FullscreenClicked"
            SettingsClicked="CommandBar_SettingsClicked"/>

        <!-- 设置面板覆盖层（Windows 8 形态：从右侧滑入，346px 全高） -->
        <metro:MetroSettingsPanelControl x:Name="SettingsPanel" Grid.RowSpan="4"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed"
            CloseRequested="SettingsPanel_CloseRequested"
            ZoomInRequested="SettingsPanel_ZoomInRequested"
            ZoomOutRequested="SettingsPanel_ZoomOutRequested"
            ZoomResetRequested="SettingsPanel_ZoomResetRequested"
            ClearHistoryRequested="SettingsPanel_ClearHistoryRequested"/>

        <!-- 全屏缩略图网格覆盖层 -->
        <metro:MetroTabGridControl x:Name="TabGridOverlay" Grid.RowSpan="4"
            Visibility="Collapsed"
            TabSelected="TabGrid_TabSelected"
            TabCloseRequested="TabGrid_TabCloseRequested"
            NewTabRequested="TabGrid_NewTabRequested"
            DismissRequested="TabGrid_DismissRequested"/>
    </Grid>
</Page>
