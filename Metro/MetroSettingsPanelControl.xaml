<UserControl
    x:Class="EdgeRebuild.Metro.MetroSettingsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置面板（Windows 8 设置面板形态：从右侧滑入，346px 宽，全高）：
         清除浏览数据 / 位置权限 / 缩放 / 编码 / 版本信息 -->
    <Border Width="346" Background="#FF2D2D30" BorderBrush="#FF3C3C3C" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：标题 + 关闭 -->
            <Grid Grid.Row="0" Height="56" Padding="20,0,8,0">
                <TextBlock Text="设置" FontFamily="Segoe UI Light" FontSize="28"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Width="40" Height="40" Click="CloseBtn_Click"/>
            </Grid>

            <!-- 内容（滚动） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="20,0,20,12">

                    <!-- 清除浏览数据 -->
                    <TextBlock Text="清除浏览数据" FontSize="12" Foreground="#FF7A7A7A" Margin="0,0,0,8"/>
                    <Button Content="清除历史记录" HorizontalAlignment="Left"
                            Background="#FF1E1E1E" Foreground="White" BorderThickness="0"
                            Padding="16,10" MinWidth="160" Click="ClearHistoryBtn_Click"/>
                    <TextBlock Text="删除浏览历史与最近关闭的标签页" FontSize="12"
                               Foreground="#FF7A7A7A" Margin="0,6,0,20" TextWrapping="Wrap"/>

                    <!-- 位置权限 -->
                    <TextBlock Text="位置权限" FontSize="12" Foreground="#FF7A7A7A" Margin="0,0,0,8"/>
                    <Grid>
                        <TextBlock Text="允许网站访问我的位置" FontSize="14" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="LocationToggle" HorizontalAlignment="Right"
                                      OnContent="" OffContent="" MinWidth="0"
                                      Toggled="LocationToggle_Toggled"/>
                    </Grid>
                    <TextBlock Text="开启后网站可请求位置信息" FontSize="12"
                               Foreground="#FF7A7A7A" Margin="0,6,0,20" TextWrapping="Wrap"/>

                    <!-- 缩放 -->
                    <TextBlock Text="缩放" FontSize="12" Foreground="#FF7A7A7A" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Background="#FF1E1E1E" Foreground="White" BorderThickness="0"
                                Width="48" Height="48" HorizontalAlignment="Left" Click="ZoomOutBtn_Click"/>
                        <TextBlock Grid.Column="1" x:Name="ZoomPercentText" Text="100%"
                                   FontSize="14" Foreground="White" MinWidth="64"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="&#xE739;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Background="#FF1E1E1E" Foreground="White" BorderThickness="0"
                                Width="48" Height="48" HorizontalAlignment="Left" Click="ZoomInBtn_Click"/>
                        <Button Grid.Column="3" Content="重置" FontSize="14" Margin="12,0,0,0"
                                Background="#FF1E1E1E" Foreground="White" BorderThickness="0"
                                Padding="12,10" Click="ZoomResetBtn_Click"/>
                    </Grid>
                    <TextBlock Text="仅对当前页面生效" FontSize="12"
                               Foreground="#FF7A7A7A" Margin="0,6,0,20"/>

                    <!-- 编码 -->
                    <TextBlock Text="编码" FontSize="12" Foreground="#FF7A7A7A" Margin="0,0,0,8"/>
                    <ComboBox x:Name="EncodingBox" MinWidth="200" HorizontalAlignment="Left"
                              FontSize="14" SelectionChanged="EncodingBox_SelectionChanged">
                        <ComboBoxItem Content="自动检测"/>
                        <ComboBoxItem Content="Unicode (UTF-8)"/>
                        <ComboBoxItem Content="简体中文 (GBK)"/>
                        <ComboBoxItem Content="繁体中文 (Big5)"/>
                    </ComboBox>
                    <TextBlock Text="当前引擎不支持手动切换编码" FontSize="12"
                               Foreground="#FF7A7A7A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 版本信息 -->
            <StackPanel Grid.Row="2" Padding="20,12,20,16">
                <Border Height="1" Background="#FF3C3C3C" Margin="0,0,0,12"/>
                <TextBlock Text="EdgeRebuild Pre-release" FontSize="12" Foreground="#FF7A7A7A"/>
                <TextBlock Text="Windows 8 版 Internet Explorer 界面样式" FontSize="12" Foreground="#FF7A7A7A"/>
                <TextBlock Text="© 2026" FontSize="12" Foreground="#FF7A7A7A"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
