<UserControl
    x:Class="EdgeRebuild.Metro.MetroSettingsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设置面板（IE10/IE11 Modern 设置页形态）：
         白色系统面板、灰色按钮、矩形开关、分段缩放条、浅色下拉框。
         注意：Tabs/Favorites/Suggestions 是黑色 IE 面板，设置页是白色系统面板，
         两套语言不要混用。 -->
    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF999999"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 灰色扁平按钮：删除 / 清除 -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFE6E6E6"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFDADADA"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFCCCCCC"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FFF2F2F2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 矩形开关：左侧“开/关”文字，右侧 36×16 轨道 + 14×14 方形滑块。
             开关形态由代码隐藏直接更新 Track/Knob，不依赖 CheckStates 视觉状态
             （1809 上自定义 ToggleButton 模板的视觉状态在部分场景不生效）。 -->
        <Style x:Key="MetroSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootPanel" Storyboard.TargetProperty="Opacity"
                                                             To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootPanel" Storyboard.TargetProperty="Opacity"
                                                             To="0.65" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootPanel" Storyboard.TargetProperty="Opacity"
                                                             To="0.45" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <StackPanel x:Name="RootPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="#FF000000" FontFamily="Segoe UI" FontSize="11"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border x:Name="Track" Width="36" Height="16"
                                        Background="#FFC8C8C8" BorderBrush="#FFC8C8C8" BorderThickness="0">
                                    <Border x:Name="Knob" Width="14" Height="14" Background="White"
                                            BorderBrush="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Left" Margin="1"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段缩放条：按钮外壳保证可聚焦/键盘左右键可用，内部 Grid 画 11 段 -->
        <Style x:Key="ZoomBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="346" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0"
            RequestedTheme="Light">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 头部：齿轮 + Metro IE 设置 -->
            <Grid Grid.Row="0" Height="56" Padding="20,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                              Foreground="#FF000000" VerticalAlignment="Center"/>
                    <TextBlock Text="Metro IE 设置" FontFamily="Segoe UI" FontSize="22"
                               Foreground="#FF000000" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Foreground="#FF666666" Background="Transparent" BorderThickness="0"
                        Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseBtn_Click" ToolTipService.ToolTip="关闭设置"
                        AutomationProperties.Name="关闭设置"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <StackPanel Padding="20,8,20,24">

                    <!-- 删除浏览历史记录 -->
                    <TextBlock Text="删除浏览历史记录" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                    <Button Content="删除" Style="{StaticResource SettingsButtonStyle}"
                            HorizontalAlignment="Left" Click="ClearHistoryBtn_Click"
                            AutomationProperties.Name="删除浏览历史记录"/>

                    <!-- 权限 -->
                    <TextBlock Text="权限" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <TextBlock Text="某些网站可能会请求获取你的实际位置信息。"
                               Style="{StaticResource BodyStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="请求位置信息" Style="{StaticResource RowLabelStyle}"/>
                        <ToggleButton x:Name="LocationToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="关" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="LocationToggle_Checked" Unchecked="LocationToggle_Unchecked"
                                      AutomationProperties.Name="请求位置信息"/>
                    </Grid>
                    <TextBlock Text="如果你已经允许某些网站获取你的位置，则可以清除现有的所有权限，然后重新设置。"
                               Style="{StaticResource BodyStyle}" Margin="0,8,0,8"/>
                    <Button Content="清除" Style="{StaticResource SettingsButtonStyle}"
                            HorizontalAlignment="Left" Click="ClearLocationBtn_Click"
                            AutomationProperties.Name="清除位置权限"/>

                    <!-- 隐私（当前版本保留的 InPrivate 能力，不在原版设置页中） -->
                    <TextBlock Text="隐私" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="InPrivate 模式" Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="新开标签不写历史、不留会话痕迹（已开标签不受影响）"
                                       Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="InPrivateToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="关" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Checked="InPrivateToggle_Checked" Unchecked="InPrivateToggle_Unchecked"
                                      AutomationProperties.Name="InPrivate 模式"/>
                    </Grid>

                    <!-- 缩放 -->
                    <Grid Margin="0,24,0,0">
                        <TextBlock Text="缩放" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                        <TextBlock x:Name="ZoomPercentText" Text="100%" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="#FF0078D7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="ZoomBar" Style="{StaticResource ZoomBarButtonStyle}" Height="22"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Margin="0,8,0,0" KeyDown="ZoomBar_KeyDown"
                            ToolTipService.ToolTip="缩放" AutomationProperties.Name="缩放"
                            AutomationProperties.HelpText="拖动或使用左右方向键调整缩放">
                        <Grid Height="18" HorizontalAlignment="Stretch">
                            <Border Background="#FFF2F2F2" BorderBrush="#FFD0D0D0" BorderThickness="1"
                                    HorizontalAlignment="Stretch"/>
                            <Grid x:Name="ZoomBarSegments" Height="16" Margin="1"
                                  HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Button>

                    <!-- 快速翻页（原版设置页有此项；本版本不实现，也不收集浏览历史） -->
                    <TextBlock Text="快速翻页" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <TextBlock Text="快速翻页会在页面上提供“下一页”入口，方便连续阅读。"
                               Style="{StaticResource BodyStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="启用快速翻页" Style="{StaticResource RowLabelStyle}"/>
                        <ToggleButton x:Name="FlipAheadToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="关" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      AutomationProperties.Name="启用快速翻页"/>
                    </Grid>
                    <TextBlock Text="此版本不提供快速翻页，也不会收集或发送浏览历史。"
                               Style="{StaticResource HintStyle}" Margin="0,6,0,0"/>

                    <!-- 编码 -->
                    <TextBlock Text="编码" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <TextBlock Text="当前引擎会自动检测网页编码。手动切换编码和文字方向暂不支持。"
                               Style="{StaticResource BodyStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="自动选择编码" Style="{StaticResource RowLabelStyle}"/>
                        <ToggleButton x:Name="AutoEncodingToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="开" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="AutoEncodingToggle_Checked" Unchecked="AutoEncodingToggle_Unchecked"
                                      AutomationProperties.Name="自动选择编码"/>
                    </Grid>
                    <ComboBox x:Name="EncodingBox" SelectedIndex="0" IsEnabled="False"
                              Height="32" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                              FontFamily="Segoe UI" FontSize="12"
                              SelectionChanged="EncodingBox_SelectionChanged"
                              AutomationProperties.Name="编码">
                        <ComboBoxItem Content="Unicode (UTF-8)"/>
                        <ComboBoxItem Content="简体中文 (GBK)"/>
                        <ComboBoxItem Content="繁体中文 (Big5)"/>
                        <ComboBoxItem Content="西欧 (Windows-1252)"/>
                    </ComboBox>
                    <TextBlock Text="文字方向" Style="{StaticResource RowLabelStyle}" Margin="0,8,0,0"/>
                    <ComboBox x:Name="TextDirectionBox" SelectedIndex="0" IsEnabled="False"
                              Height="32" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                              FontFamily="Segoe UI" FontSize="12"
                              SelectionChanged="TextDirectionBox_SelectionChanged"
                              AutomationProperties.Name="文字方向">
                        <ComboBoxItem Content="从左到右的文档"/>
                        <ComboBoxItem Content="从右到左的文档"/>
                    </ComboBox>
                    <TextBlock Text="编码与文字方向由引擎自动处理，无法手动切换。"
                               Style="{StaticResource HintStyle}" Margin="0,4,0,0"/>

                    <!-- 浏览器：IE11 的“始终显示地址栏和标签” -->
                    <TextBlock Text="浏览器" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="始终显示地址栏和标签" Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="关闭后向下滚动会收起底栏，向上滚动恢复。"
                                       Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AlwaysShowChromeToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="开" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Checked="AlwaysShowChromeToggle_Checked" Unchecked="AlwaysShowChromeToggle_Unchecked"
                                      AutomationProperties.Name="始终显示地址栏和标签"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="按钮圆圈" Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="关闭后地址栏和标签条按钮只显示图标，不画外围圆圈。"
                                       Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="CircleButtonsToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="开" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Checked="CircleButtonsToggle_Checked" Unchecked="CircleButtonsToggle_Unchecked"
                                      AutomationProperties.Name="按钮圆圈"/>
                    </Grid>

                    <!-- 调试选项：默认形态是三列建议面板，旧版单列 Flyout 仅用于对比/排查 -->
                    <TextBlock Text="调试" Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,8"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="旧版单列建议" Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="调试选项：关闭默认的三列建议面板，恢复旧版单列建议浮层。"
                                       Style="{StaticResource BodyStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="CompactSuggestionsToggle" Style="{StaticResource MetroSwitchStyle}"
                                      Content="关" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Checked="CompactSuggestionsToggle_Checked" Unchecked="CompactSuggestionsToggle_Unchecked"
                                      AutomationProperties.Name="旧版单列建议（调试）"/>
                    </Grid>

                    <TextBlock Text="EdgeRebuild Pre-release · Metro IE 界面样式"
                               Style="{StaticResource HintStyle}" Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
