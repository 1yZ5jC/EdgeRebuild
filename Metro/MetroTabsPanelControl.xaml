<UserControl
    x:Class="EdgeRebuild.Metro.MetroTabsPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- IE11 式底部 Tabs 面板：标题栏 + 横向缩略图列表。
         由 MetroPage 用 Flyout 承载（规避 EdgeHTML WebView 的 airspace 覆盖问题），
         面板本身不参与全屏网格；网格通过右上“展开”按钮进入。 -->
    <UserControl.Resources>
        <Style x:Key="PanelIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF0F0F0F" BorderBrush="#FF3A3A3A" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：标签页 + 新建 / 展开 / 关闭 -->
        <Grid Grid.Row="0" Padding="16,0,8,0">
            <TextBlock Text="标签页" FontFamily="Segoe UI Light" FontSize="18"
                       Foreground="White" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="NewTabBtn" Content="&#xE710;" Style="{StaticResource PanelIconButtonStyle}"
                        Click="NewTabBtn_Click" ToolTipService.ToolTip="新建标签"
                        AutomationProperties.Name="新建标签"/>
                <Button x:Name="MoreBtn" Content="&#xE712;" Style="{StaticResource PanelIconButtonStyle}"
                        Click="MoreBtn_Click" ToolTipService.ToolTip="更多标签操作"
                        AutomationProperties.Name="更多标签操作"/>
                <Button x:Name="CloseBtn" Content="&#xE711;" Style="{StaticResource PanelIconButtonStyle}"
                        Click="CloseBtn_Click" ToolTipService.ToolTip="关闭标签面板"
                        AutomationProperties.Name="关闭标签面板"/>
            </StackPanel>
        </Grid>

        <!-- 横向缩略图：ItemsStackPanel 单行排列，交给 ListView 的 ScrollViewer 横向滚动 -->
        <ListView x:Name="TabList" Grid.Row="1"
                  IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="TabList_ItemClick"
                  Padding="8,0,8,8"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="没有打开的标签页"
                   FontFamily="Segoe UI Light" FontSize="16" Foreground="#FF8E8E8E"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
