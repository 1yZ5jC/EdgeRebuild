<UserControl
    x:Class="EdgeRebuild.Controls.ToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 为工具栏定义独立的笔刷，避免与主页面冲突 -->
        <SolidColorBrush x:Key="ToolbarRevealHover" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarRevealPressed" Color="#80FFFFFF"/>

        <Style x:Key="ToolbarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolbarRevealHover}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolbarRevealPressed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverBorder" Background="Transparent">
                                <ContentPresenter x:Name="ContentPresenter" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" BorderThickness="0,1,0,1" Background="Transparent">
        <Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WidthStates">
                    <VisualState x:Name="Wide">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UrlBox" Storyboard.TargetProperty="MinWidth">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="200"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EngineCombo" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UrlBox" Storyboard.TargetProperty="MinWidth">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="200"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="EngineCombo" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CaptureBtn" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                            </ObjectAnimationUsingKeyFrames>
                            <!-- 窄窗允许地址栏继续收缩，窗口才能降到 Hub 响应式阈值以下 -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UrlBox" Storyboard.TargetProperty="MinWidth">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="80"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 引擎标记 -->
            <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="2,0,2,0" Background="Transparent">
                <TextBlock x:Name="EngineLabel" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="Bold"/>
            </Border>

            <Button x:Name="BackBtn" Grid.Column="1" Content="&#xE72B;" IsEnabled="False"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource ToolbarNavButtonStyle}" Click="BackBtn_Click"
                    ToolTipService.ToolTip="后退" AutomationProperties.Name="后退"/>
            <Button x:Name="ForwardBtn" Grid.Column="2" Content="&#xE72A;" IsEnabled="False"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource ToolbarNavButtonStyle}" Click="ForwardBtn_Click"
                    ToolTipService.ToolTip="前进" AutomationProperties.Name="前进"/>
            <Button x:Name="RefreshBtn" Grid.Column="3" Content="&#xE72C;"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource ToolbarNavButtonStyle}" Click="RefreshBtn_Click"
                    ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"/>

            <!-- 地址栏：安全图标内嵌在输入框左侧 -->
            <Grid Grid.Column="4">
                <TextBox x:Name="UrlBox" MinWidth="200" 
                         PlaceholderText=""
                         KeyDown="UrlBox_KeyDown" GotFocus="UrlBox_GotFocus" LostFocus="UrlBox_LostFocus"
                         TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="LightGray" BorderThickness="1"
                         Padding="32,8,32,0" VerticalAlignment="Stretch" FontSize="13"
                         AutomationProperties.Name="地址栏">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="SuggestionsFlyout" Placement="Bottom"
                                ShowMode="Transient" AllowFocusOnInteraction="False">
                            <Border x:Name="SuggestionBorder" Background="Transparent" BorderThickness="0" MinWidth="200" MaxHeight="200">
                                <StackPanel x:Name="SuggestionsPanel" Orientation="Vertical" />
                            </Border>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </TextBox>

                <Button x:Name="SiteInfoButton" 
                        Width="28" Height="28" Margin="2,0,0,0" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Click="SiteInfoButton_Click"
                        ToolTipService.ToolTip="站点信息"
                        AutomationProperties.Name="站点信息">
                    <TextBlock x:Name="SiteInfoText" Text="&#xE72E;" FontSize="14"
                               FontFamily="Segoe MDL2 Assets"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <Button x:Name="AddFavBtn"
                        Width="28" Height="28" Margin="0,0,2,0" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Click="AddFavBtn_Click"
                        ToolTipService.ToolTip="添加到收藏夹"
                        AutomationProperties.Name="添加到收藏夹">
                    <FontIcon x:Name="AddFavGlyph" Glyph="&#xE734;"
                              FontFamily="Segoe MDL2 Assets" FontSize="14"
                              RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform x:Name="AddFavScale" ScaleX="1" ScaleY="1"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="FavoriteEditFlyout" Placement="Bottom"
                                Opened="FavoriteEditFlyout_Opened">
                            <StackPanel Width="300" Spacing="8">
                                <TextBlock x:Name="FavoriteEditTitleText" Text="添加收藏"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBox x:Name="FavoriteNameBox" Header="名称"
                                         PlaceholderText="收藏名称"
                                         KeyDown="FavoriteNameBox_KeyDown"/>
                                <ComboBox x:Name="FavoriteFolderCombo" Header="位置"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="FavoriteFolderCombo_SelectionChanged"/>
                                <HyperlinkButton x:Name="NewFavoriteFolderBtn" Content="+ 新建文件夹"
                                                 Padding="0" FontSize="12"
                                                 HorizontalAlignment="Left"
                                                 Click="NewFavoriteFolderBtn_Click"/>
                                <StackPanel x:Name="NewFavoriteFolderPanel" Spacing="6"
                                            Visibility="Collapsed">
                                    <TextBox x:Name="NewFavoriteFolderNameBox"
                                             PlaceholderText="文件夹名称"
                                             KeyDown="NewFavoriteFolderNameBox_KeyDown"/>
                                    <TextBlock x:Name="NewFavoriteFolderParentText"
                                               FontSize="12" Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CreateFavoriteFolderBtn" Content="创建"
                                                Click="CreateFavoriteFolderBtn_Click"/>
                                        <Button Content="取消"
                                                Click="CancelNewFavoriteFolderBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Margin="0,4,0,0">
                                    <Button x:Name="FavoriteDeleteBtn" Content="删除收藏"
                                            HorizontalAlignment="Left"
                                            Visibility="Collapsed"
                                            Click="FavoriteDeleteBtn_Click"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Content="取消" Click="FavoriteCancelBtn_Click"/>
                                        <Button x:Name="FavoriteSaveBtn" Content="添加"
                                                Click="FavoriteSaveBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </Grid>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <Button x:Name="CaptureBtn" Content="&#xE931;"
                        Width="32" Height="32" Margin="2,0" Click="CaptureBtn_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        ToolTipService.ToolTip="网页捕获（截图批注）"
                        AutomationProperties.Name="网页捕获（截图批注）"/>
                <Button x:Name="HubBtn" Content="&#xE728;"
                        Width="32" Height="32" Margin="2,0" Click="HubBtn_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        ToolTipService.ToolTip="Hub 中心"
                        AutomationProperties.Name="Hub 中心"/>
                <Button x:Name="MenuBtn" Content="&#xE712;"
                        Width="32" Height="32" Margin="2,0" Click="MenuBtn_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        ToolTipService.ToolTip="菜单"
                        AutomationProperties.Name="菜单"/>
                <ComboBox x:Name="EngineCombo" MinWidth="90" MaxWidth="132" SelectedIndex="0" VerticalAlignment="Center"
                          Background="Transparent" BorderThickness="0" Margin="4,0" SelectionChanged="EngineCombo_SelectionChanged"
                          AutomationProperties.Name="渲染引擎">
                    <ComboBoxItem Content="EdgeHTML"/>
                    <ComboBoxItem Content="WebView2"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>