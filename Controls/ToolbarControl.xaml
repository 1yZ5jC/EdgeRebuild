<UserControl
    x:Class="EdgeRebuild.Controls.ToolbarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#40FFFFFF"/>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolbarButtonHoverBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolbarButtonPressedBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0.4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="HoverBorder" Background="Transparent" CornerRadius="2">
                                <ContentPresenter x:Name="ContentPresenter" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" BorderThickness="0,1,0,1" Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 引擎标记 -->
            <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="2,0,2,0" Background="Transparent">
                <TextBlock x:Name="EngineLabel" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="13" FontWeight="Bold"/>
            </Border>

            <!-- 前进/后退/刷新按钮 -->
            <Button x:Name="BackBtn" Grid.Column="1" Content="&#xE72B;" IsEnabled="False"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource NavigationButtonStyle}" Click="BackBtn_Click"/>
            <Button x:Name="ForwardBtn" Grid.Column="2" Content="&#xE72A;" IsEnabled="False"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource NavigationButtonStyle}" Click="ForwardBtn_Click"/>
            <Button x:Name="RefreshBtn" Grid.Column="3" Content="&#xE72C;"
                    Width="32" Height="32" Margin="2,0"
                    Style="{StaticResource NavigationButtonStyle}" Click="RefreshBtn_Click"/>

            <!-- 地址栏：安全图标内嵌在输入框左侧 -->
            <Grid Grid.Column="4">
                <!-- 地址栏输入框，文字左侧留出空间给图标 -->
                <TextBox x:Name="UrlBox" MinWidth="200" 
                         PlaceholderText="输入网址或搜索（@引擎 临时切换）"
                         KeyDown="UrlBox_KeyDown" GotFocus="UrlBox_GotFocus" LostFocus="UrlBox_LostFocus"
                         TextChanged="UrlBox_TextChanged" VerticalContentAlignment="Center"
                         Background="White" BorderBrush="LightGray" BorderThickness="1"
                         Padding="32,8,4,0" VerticalAlignment="Stretch" FontSize="13">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="SuggestionsFlyout" Placement="Bottom">
                            <Border x:Name="SuggestionBorder" Background="Transparent" BorderThickness="0" MinWidth="200" MaxHeight="200">
                                <StackPanel x:Name="SuggestionsPanel" Orientation="Vertical" />
                            </Border>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </TextBox>

                <!-- 安全信息按钮（覆盖在输入框左侧内部） -->
                <Button x:Name="SiteInfoButton" 
                        Width="28" Height="28" Margin="2,0,0,0" Padding="0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Click="SiteInfoButton_Click">
                    <TextBlock x:Name="SiteInfoText" Text="🔒" FontSize="14"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 右侧工具按钮 -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                <Button x:Name="AddFavBtn" Content="&#xE734;"
                        Width="32" Height="32" Margin="2,0" Click="AddFavBtn_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                <Button x:Name="HubBtn" Content="📚"
                        Width="32" Height="32" Margin="2,0" Click="HubBtn_Click"
                        Background="Transparent" BorderThickness="0" FontSize="14"/>
                <Button x:Name="MenuBtn" Content="&#xE712;"
                        Width="32" Height="32" Margin="2,0" Click="MenuBtn_Click"
                        Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                <ComboBox x:Name="EngineCombo" Width="90" SelectedIndex="0" VerticalAlignment="Center"
                          Background="Transparent" BorderThickness="0" Margin="4,0" SelectionChanged="EngineCombo_SelectionChanged">
                    <ComboBoxItem Content="EdgeHTML"/>
                    <ComboBoxItem Content="WebView2"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>