<UserControl
    x:Class="EdgeRebuild.Controls.SettingsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="SettingsNavView"
        PaneDisplayMode="Left"
        OpenPaneLength="160"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        AlwaysShowHeader="True"
        SelectionChanged="SettingsNavView_SelectionChanged"
        Background="Transparent">

        <NavigationView.HeaderTemplate>
            <DataTemplate>
                <Border Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CloseButton" 
                                Content="&#xE711;" 
                                FontFamily="Segoe MDL2 Assets"
                                Background="Transparent"
                                Click="CloseButton_Click"
                                Width="32" Height="32" 
                                HorizontalAlignment="Left"/>
                        <TextBlock Text="设置" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </NavigationView.HeaderTemplate>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="常规" Tag="General">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="外观" Tag="Appearance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="下载" Tag="Download">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="引擎" Tag="Engine">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE943;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="隐私" Tag="Privacy">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7EB;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="性能" Tag="Performance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE787;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="调试" Tag="Debug">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <ContentControl x:Name="ContentArea" 
                        HorizontalContentAlignment="Stretch" 
                        VerticalContentAlignment="Stretch"/>
    </NavigationView>
</UserControl>