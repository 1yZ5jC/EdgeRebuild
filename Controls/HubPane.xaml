<UserControl
    x:Class="EdgeRebuild.Controls.HubPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:EdgeRebuild.Controls"
    Background="Transparent"
    IsHitTestVisible="True"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- 亮色主题列表项样式 -->
        <Style x:Key="HubListViewItemStyleLight" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="ContentBorder" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#D9EAF7"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#C0DDF2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#B3D4ED"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#A0C8E6"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#8CB9D9"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Margin="12,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 暗色主题列表项样式 -->
        <Style x:Key="HubListViewItemStyleDark" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="ContentBorder" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1A3A5C"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0F2A45"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0D2540"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0B1E35"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentBorder" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#08182A"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Margin="12,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 历史分组表头模板 -->
        <DataTemplate x:Key="HistoryHeaderTemplate">
            <Grid Padding="12,6,12,6" Background="Transparent" RightTapped="HistoryHeader_RightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChevronText" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="HeaderTitleText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderCountText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- 历史项模板(与表头分离,供模板选择器使用) -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <Grid x:Name="RootGrid" Padding="12,8,12,8" Background="Transparent"
                  RightTapped="HistoryItem_RightTapped">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontWeight="Normal" FontSize="14"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UrlText" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <TextBlock x:Name="TimeText" FontSize="10"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:HistoryTemplateSelector x:Key="HistoryListTemplateSelector"
                                       HeaderTemplate="{StaticResource HistoryHeaderTemplate}"
                                       ItemTemplate="{StaticResource HistoryItemTemplate}"/>
    </UserControl.Resources>

    <Grid Background="Transparent" IsHitTestVisible="True">
        <muxc:NavigationView
            x:Name="HubNavView"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            SelectionChanged="HubNavView_SelectionChanged"
            Background="Transparent"
            IsHitTestVisible="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="收藏夹" Tag="Favorites">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史记录" Tag="History">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="稍后读" Tag="ReadingList">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="下载" Tag="Downloads">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="集锦" Tag="Collections">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <ScrollViewer>
                <Grid>
                    <!-- 收藏夹面板 -->
                    <StackPanel x:Name="FavPanel" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" Margin="12,8,12,4" Spacing="8">
                            <!-- 新增：收藏夹搜索框 -->
                            <TextBox x:Name="FavoritesSearchBox" 
                                     PlaceholderText="搜索收藏夹..." 
                                     Width="150"
                                     TextChanged="FavoritesSearchBox_TextChanged"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="ImportFavBtn" Content="导入"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="10,4" FontSize="12"
                                    Click="ImportFavBtn_Click"/>
                            <Button x:Name="ExportFavBtn" Content="导出"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="10,4" FontSize="12"
                                    Click="ExportFavBtn_Click"/>
                            <Button x:Name="ToggleManageBtn" Content="管理"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="10,4" FontSize="12"
                                    Click="ToggleManageBtn_Click"/>
                        </StackPanel>

                        <!-- 多选管理操作栏 -->
                        <Border x:Name="ManageBar" Visibility="Collapsed" Margin="12,0,12,4"
                                Padding="8,6" BorderBrush="LightGray" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ManageCountText" Text="0 项已选择" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ManageDeleteBtn" Content="删除"
                                        IsEnabled="False" Click="ManageDeleteBtn_Click"
                                        Margin="0,0,8,0" Padding="10,4" FontSize="12"/>
                                <Button Grid.Column="2" x:Name="ManageCancelBtn" Content="取消"
                                        Click="ManageCancelBtn_Click" Padding="10,4" FontSize="12"
                                        Background="Transparent" BorderThickness="1" BorderBrush="LightGray"/>
                            </Grid>
                        </Border>

                        <ListView x:Name="FavListView" 
                                  SelectionMode="None"
                                  IsItemClickEnabled="True" 
                                  ItemClick="FavListView_ItemClick"
                                  SelectionChanged="FavListView_SelectionChanged"
                                  ContainerContentChanging="FavListView_ContainerContentChanging"
                                  Background="Transparent"
                                  MinHeight="300"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RootGrid" Padding="12,8,12,8" Background="Transparent"
                                          RightTapped="FavItem_RightTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="FavIcon" Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                  Foreground="Gold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleText" FontWeight="Normal" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="UrlText" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                            <TextBlock x:Name="DateText" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- 历史记录面板 -->
                    <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                        <StackPanel x:Name="HistoryToolbar" Orientation="Horizontal" Margin="12,8,12,4" Spacing="8">
                            <!-- 新增：历史记录搜索框 -->
                            <TextBox x:Name="HistorySearchBox" 
                                     PlaceholderText="搜索历史..." 
                                     Width="180"
                                     TextChanged="HistorySearchBox_TextChanged"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="ClearHistoryBtn" Content="清除全部历史"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="12,4" FontSize="12"
                                    Click="ClearHistoryBtn_Click"/>
                        </StackPanel>

                        <!-- InPrivate：不展示历史列表，改为面板内提示 -->
                        <StackPanel x:Name="InPrivateNotice" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,80,0,0">
                            <TextBlock Text="&#xEC25;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="28" HorizontalAlignment="Center"
                                       Foreground="Gray" Margin="0,0,0,12"/>
<TextBlock Text="InPrivate 模式下不会记录历史记录"
                           FontSize="14" Foreground="Gray"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="260"/>
                        </StackPanel>

                        <ListView x:Name="HistoryListView" 
                                  SelectionMode="None"
                                  IsItemClickEnabled="True" 
                                  ItemClick="HistoryListView_ItemClick"
                                  ItemTemplateSelector="{StaticResource HistoryListTemplateSelector}"
                                  ContainerContentChanging="HistoryListView_ContainerContentChanging"
                                  Background="Transparent"
                                  MinHeight="300"
                                  HorizontalAlignment="Stretch"
                                  Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- 稍后读面板（旧版 Edge 阅读列表：一次性阅读队列） -->
                    <StackPanel x:Name="ReadingPanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="12,8,12,4" Spacing="8">
                            <TextBlock Text="读完即删，长期保存请用收藏夹" FontSize="12"
                                       Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListView x:Name="ReadingListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ReadingListView_ItemClick"
                                  Background="Transparent"
                                  MinHeight="300"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="RootGrid" Padding="12,8,12,8" Background="Transparent"
                                          RightTapped="ReadingItem_RightTapped">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                  Foreground="#FF0078D7" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleText" FontWeight="Normal" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="UrlText" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                            <TextBlock x:Name="DateText" FontSize="10"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- 下载面板 -->
                    <ScrollViewer x:Name="DownloadsContainer" 
                                  Visibility="Collapsed"
                                  MinHeight="200"
                                  HorizontalAlignment="Stretch" 
                                  VerticalAlignment="Stretch">
                        <StackPanel x:Name="DownloadsStackPanel" Orientation="Vertical" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>

                    <!-- 集锦面板 -->
                    <StackPanel x:Name="CollectionsPanel" Visibility="Collapsed">
                        <!-- 工具栏 -->
                        <StackPanel Orientation="Horizontal" Margin="12,8,12,4" Spacing="8">
                            <Button x:Name="NewCollectionGroupBtn" Content="新建分组"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="10,4" FontSize="12"
                                    Click="NewCollectionGroupBtn_Click"/>
                            <Button x:Name="ExportCollectionBtn" Content="导出"
                                    Background="Transparent"
                                    BorderThickness="1" BorderBrush="LightGray"
                                    Padding="10,4" FontSize="12"
                                    Click="ExportCollectionBtn_Click"/>
                        </StackPanel>

                        <!-- 分组列表（顶层） -->
                        <StackPanel x:Name="CollectionGroupList" Visibility="Visible"/>

                        <!-- 条目列表（进入分组后显示） -->
                        <StackPanel x:Name="CollectionItemListContainer" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4" Spacing="8">
                                <Button x:Name="CollectionBackBtn" Content="← 返回"
                                        Background="Transparent"
                                        BorderThickness="1" BorderBrush="LightGray"
                                        Padding="10,4" FontSize="12"
                                        Click="CollectionBackBtn_Click"/>
                                <TextBlock x:Name="CollectionGroupNameText" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ListView x:Name="CollectionItemListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="CollectionItemListView_ItemClick"
                                      Background="Transparent"
                                      MinHeight="200"
                                      HorizontalAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8,12,8" Background="Transparent"
                                              RightTapped="CollectionItem_RightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" x:Name="ItemIcon" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="ContentText" FontSize="11" Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </muxc:NavigationView>
    </Grid>
</UserControl>