<UserControl
    x:Class="EdgeRebuild.Controls.SweptTabsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F0F0F0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    KeyDown="Root_KeyDown">

    <UserControl.Resources>
        <!-- 卡片换行：一行最多 4 张，窗口变窄自动降为 3/2/1 张 -->
        <ItemsPanelTemplate x:Key="SweptCardsPanel">
            <ItemsWrapGrid Orientation="Horizontal"
                           MaximumRowsOrColumns="4"
                           ItemWidth="150"
                           ItemHeight="128"/>
        </ItemsPanelTemplate>

        <Style x:Key="PaneTextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaneIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0"
                Padding="16,12,8,10"
                Background="Transparent"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <FontIcon x:Name="HeaderIcon" Grid.RowSpan="2" Grid.Column="0"
                          Glyph="&#xED50;" FontSize="20"
                          FontFamily="{StaticResource BrowserMdlFontFamily}"
                          VerticalAlignment="Top" Margin="0,2,10,0"/>

                <TextBlock x:Name="TitleText" Grid.Column="1" Grid.Row="0"
                           Text="已搁置的标签页" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Grid.Column="1" Grid.Row="1"
                           Text="暂时不用的标签收进这里，稍后整组还原"
                           FontSize="12" TextWrapping="Wrap" MaxLines="2"
                           Margin="0,2,12,0"/>

                <Button x:Name="SweepOtherBtn" Grid.Column="2" Grid.RowSpan="2"
                        Content="搁置其他标签页"
                        Style="{StaticResource PaneTextButtonStyle}"
                        Click="SweepOtherBtn_Click"
                        VerticalAlignment="Center" Margin="0,0,4,0"
                        AutomationProperties.Name="搁置其他标签页"/>

                <Button x:Name="CloseBtn" Grid.Column="3" Grid.RowSpan="2"
                        Content="&#xE711;"
                        Style="{StaticResource PaneIconButtonStyle}"
                        Click="CloseBtn_Click"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="关闭已搁置的标签页面板"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="GroupsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          HorizontalScrollMode="Disabled">
                <StackPanel x:Name="GroupsPanel" Margin="16,8,16,24"/>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Spacing="10"
                        Visibility="Collapsed">
                <FontIcon x:Name="EmptyIcon" Glyph="&#xED50;" FontSize="44"
                          FontFamily="{StaticResource BrowserMdlFontFamily}"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="没有已搁置的标签页"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint"
                           Text="在标签上右键选择“搁置此标签页”，或点击上方“搁置其他标签页”。"
                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button x:Name="EmptySweepBtn" Content="搁置其他标签页"
                        Style="{StaticResource PaneTextButtonStyle}"
                        Click="SweepOtherBtn_Click"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="搁置其他标签页"/>
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Width="32" Height="32"
                          IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
